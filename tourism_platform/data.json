{
  "model": "destinations.destination",
  "pk": 3,
  "fields": {
    "name": "تجكجة",
    "region": "تكانت",
    "city": "",
    "latitude": null,
    "longitude": null,
    "description": "تجكجة مدينة تاريخية تقع في وسط موريتانيا، وهي عاصمة ولاية تكانت. تأسست في القرن 17م، واشتهرت بدورها العلمي والديني وبكونها محطة مهمة على طرق القوافل الصحراوية. عُرفت تجكجة بعلمائها وشعرائها، وبواحاتها التي وفّرت الاستقرار في قلب الصحراء. ما تزال المدينة تحتفظ بطابعها التقليدي ومكانتها الثقافية في الذاكرة الموريتانية.",
    "best_time_to_visit": "الخريف والشتاء",
    "is_published": true,
    "rating": "0.00"
  }
},
{
  "model": "destinations.destination",
  "pk": 4,
  "fields": {
    "name": "شنقيط",
    "region": "ادرار",
    "city": "",
    "latitude": null,
    "longitude": null,
    "description": "شنقيط مدينة تاريخية تقع في شمال موريتانيا بمنطقة آدرار، وتُعد من أقدم الحواضر العلمية في الصحراء الكبرى. تأسست في القرن 13م، واشتهرت كمركز للتجارة والقوافل وموئل للعلماء والفقهاء. تضم شنقيط مكتبات عريقة تحتوي آلاف المخطوطات في العلوم الشرعية واللغة والفلك، كما تُعد من المدن الإسلامية المصنّفة ضمن التراث العالمي. رغم طابعها الصحراوي الهادئ اليوم، ما تزال رمزًا للهوية الثقافية والعلمية الموريتانية.",
    "best_time_to_visit": "الكيطنة الشتاء",
    "is_published": true,
    "rating": "0.00"
  }
},
{
  "model": "destinations.destination",
  "pk": 5,
  "fields": {
    "name": "القدية",
    "region": "تكانت",
    "city": "",
    "latitude": null,
    "longitude": null,
    "description": "القدية مدينة تاريخية قديمة تقع في ولاية تكانت وسط موريتانيا. كانت القدية من الحواضر المهمة في المنطقة، واشتهرت بدورها العلمي والديني وبعلمائها، كما كانت محطة معروفة في محيط الواحات ومسارات التنقل التقليدية. اندثرت المدينة مع مرور الزمن، ولم يبقَ منها اليوم إلا آثار وشواهد تاريخية، لكنها ما تزال حاضرة في الذاكرة الثقافية لتكانت وموريتانيا عمومًا.",
    "best_time_to_visit": "الخريف والشتاء",
    "is_published": true,
    "rating": "0.00"
  }
},
{
  "model": "destinations.destination",
  "pk": 6,
  "fields": {
    "name": "الرشيد",
    "region": "تكانت",
    "city": "",
    "latitude": null,
    "longitude": null,
    "description": "الرشيد مدينة تاريخية تقع في ولاية تكانت وسط موريتانيا، وتُعد من أقدم الحواضر في المنطقة. تأسست في القرون الوسطى، وبرزت كمركز علمي وديني مهم، حيث اشتهرت بمحاظرها وعلمائها، وكانت مقصدًا لطلاب العلم من أنحاء متعددة. كما لعبت الرشيد دورًا في الحياة الاجتماعية والاقتصادية ضمن مجال الواحات ومسارات التنقل التقليدية. ورغم تراجع عمرانها اليوم، ما تزال مكانتها التاريخية والثقافية حاضرة في الذاكرة الموريتانية.",
    "best_time_to_visit": "الخريف والشتاء",
    "is_published": true,
    "rating": "0.00"
  }
},
